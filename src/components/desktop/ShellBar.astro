---
import { Icon } from 'astro-icon/components';
import AdwIcon from './AdwIcon.astro';
import MusicWave from './MusicWave.astro';
import SpotifyPlayback from './SpotifyPlayback.astro';
import ContactIcon from './ContactIcon.astro';
import ContactActions from './ContactActions.astro';
import { labelPair, menus } from '@/desktopLinks';

const endpoint = import.meta.env.PUBLIC_SPOTIFY_ENDPOINT;
const mobileContacts = menus.filter((menu) => menu.mobile !== false).flatMap((menu) => menu.items);
---
<header class="topbar" data-spotify-endpoint={endpoint}>
  <div class="topbar-start">
    <span class="workspace-indicator" aria-hidden="true"><i class="workspace-current"></i><i></i></span>

    {menus.map((menu) => {
      const label = labelPair(menu.label);
      const id = `contact-${menu.id}`;
      return (
        <div class="shell-menu" data-disclosure data-align="start">
          <button type="button" class="shell-trigger shell-contact" data-disclosure-trigger aria-controls={id} aria-expanded="false">
            {menu.icon && <ContactIcon name={menu.icon} />}
            <span data-label-zh={label.zh} data-label-en={label.en}>{label.zh}</span>
          </button>
          <div class="disclosure-panel shell-popover shell-list" id={id} inert>
            <ContactActions items={menu.items} rowClass="shell-list-row" />
          </div>
        </div>
      );
    })}
    <span class="visually-hidden" data-active-title>文章</span>

    {endpoint && (
      <div class="shell-menu music-menu" data-disclosure data-align="center">
        <button type="button" class="music-pill" data-disclosure-trigger aria-controls="music-menu" aria-expanded="false" aria-label="Spotify 播放状态" title="Spotify 播放状态" data-i18n-aria="spotifyStatus">
          <span class="music-symbol">
            <Icon name="simple-icons:spotify" aria-hidden="true" />
            <img data-spotify-cover alt="" width="18" height="18" />
          </span>
          <span class="music-pill-label" data-spotify-pill>Spotify</span>
          <MusicWave />
          <span class="music-recent-icon" data-spotify-recent hidden><AdwIcon name="document-open-recent" /></span>
        </button>

        <div class="disclosure-panel shell-popover music-popover" id="music-menu" inert>
          <SpotifyPlayback />
          <div class="music-recent" data-spotify-recent hidden>
            <header class="music-listening"><AdwIcon name="document-open-recent" /><span data-i18n="recentlyPlayed">最近听过</span></header>
            <div class="music-main">
              <div class="music-cover"><Icon name="simple-icons:spotify" aria-hidden="true" /><img data-spotify-cover alt="" width="48" height="48" /></div>
              <div class="music-track"><strong data-spotify-title></strong><span data-spotify-artist></span></div>
              <a class="spotify-open" data-spotify-link target="_blank" rel="noopener noreferrer" data-i18n-aria="openSpotify" aria-label="在 Spotify 打开" hidden><Icon name="simple-icons:spotify" aria-hidden="true" /></a>
            </div>
            <div class="music-recent-controls" data-history-controls hidden>
              <button type="button" data-history-pause aria-pressed="false">暂停轮播</button>
              <button type="button" data-history-next data-i18n="nextTrack">换一首</button>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>

  <div class="shell-menu clock-menu" data-disclosure data-align="center">
    <button type="button" class="shell-trigger clock-trigger" data-disclosure-trigger aria-controls="clock-menu" aria-expanded="false" aria-label="日期与日历" data-i18n-aria="calendar">
      <time class="topbar-clock" data-clock>博客桌面</time>
    </button>
    <div class:list={['disclosure-panel', 'shell-popover', 'clock-popover', endpoint && 'has-music']} id="clock-menu" inert>
      {endpoint && (
        <div class="clock-media">
          <div class="clock-media-card">
            <div class="clock-media-heading"><Icon name="simple-icons:spotify" aria-hidden="true" /> Spotify <span data-i18n="listeningNow" data-spotify-playing hidden>我正在听</span><span data-i18n="recentlyPlayed" data-spotify-recent hidden>最近听过</span></div>
            <div class="clock-media-idle" data-spotify-status data-spotify-idle>正在读取播放状态</div>
            <div class="clock-media-track" data-spotify-display hidden>
              <div class="music-cover"><Icon name="simple-icons:spotify" aria-hidden="true" /><img data-spotify-cover alt="" width="40" height="40" /></div>
              <div class="clock-track-text"><strong data-spotify-title></strong><span data-spotify-artist></span></div>
              <a class="spotify-open" data-spotify-link target="_blank" rel="noopener noreferrer" title="在 Spotify 打开" aria-label="在 Spotify 打开" data-i18n-aria="openSpotify" hidden><Icon name="simple-icons:spotify" aria-hidden="true" /></a>
            </div>
          </div>
        </div>
      )}
      <section class="calendar-pane" data-calendar>
        <div class="calendar-weekday" data-calendar-weekday></div>
        <div class="calendar-today" data-calendar-today></div>
        <div class="calendar-nav">
          <button type="button" data-month-step="-1" data-i18n-aria="previousMonth" aria-label="上个月"><AdwIcon name="go-previous" /></button>
          <strong data-calendar-month aria-live="polite"></strong>
          <button type="button" data-month-step="1" data-i18n-aria="nextMonth" aria-label="下个月"><AdwIcon name="go-next" /></button>
        </div>
        <div class="calendar-grid" data-calendar-grid></div>
      </section>
    </div>
  </div>

  <div class="topbar-end">
    <div class="shell-menu language-menu" data-disclosure data-align="center">
      <button type="button" class="shell-trigger language-trigger" data-disclosure-trigger aria-controls="language-menu" aria-expanded="false" data-i18n-aria="changeLanguage" aria-label="切换语言"><span data-language-indicator>拼</span></button>
      <div class="disclosure-panel shell-popover shell-list language-popover" id="language-menu" inert>
        <button type="button" class="shell-list-row" data-set-language="zh" lang="zh-CN" aria-pressed="true">中文</button>
        <button type="button" class="shell-list-row" data-set-language="en" lang="en" aria-pressed="false">English</button>
      </div>
    </div>
    <div class="shell-menu" data-disclosure data-align="end">
      <button type="button" class="shell-trigger quick-trigger" data-disclosure-trigger aria-controls="quick-settings" aria-expanded="false" data-i18n-aria="quickSettings" aria-label="快捷设置" title="快捷设置">
        {endpoint && <AdwIcon name="audio-x-generic" class="status-playing" />}
        <AdwIcon name="weather-clear-night" class="status-dark" />
        <AdwIcon name="weather-clear" class="status-light" />
        <AdwIcon name="avatar-default" class="status-profile" />
        <AdwIcon name="open-menu" class="mobile-only app-menu-icon" />
      </button>
      <div class="disclosure-panel shell-popover quick-popover" id="quick-settings" inert>
        <div class="quick-grid">
          <div class="quick-group quick-preferences">
            <h2 class="mobile-only" data-i18n="preferences">偏好设置</h2>
            <div class="quick-rows">
              <button type="button" class="quick-action" data-theme-toggle aria-pressed="true">
                <AdwIcon name="weather-clear-night" /><span data-i18n="darkStyle">暗色样式</span><span class="mobile-only app-switch" aria-hidden="true"></span>
              </button>
              <button type="button" class="quick-action" data-motion-toggle aria-pressed="true">
                <AdwIcon name="view-app-grid" /><span data-i18n="animations">界面动画</span><span class="mobile-only app-switch" aria-hidden="true"></span>
              </button>
              <label class="mobile-only app-language-row">
                <span data-i18n="language">语言</span>
                <select data-app-language>
                  <option value="zh" lang="zh-CN">中文</option>
                  <option value="en" lang="en">English</option>
                </select>
              </label>
            </div>
          </div>
          <div class="quick-group quick-links">
            <h2 class="mobile-only" data-i18n="siteLinks">站点</h2>
            <div class="quick-rows">
              <button type="button" class="quick-action quick-action--wide mobile-only app-copy-link" data-app-copy-link><AdwIcon name="insert-link" /><span data-i18n="copyLink">复制文章链接</span></button>
              <button type="button" class="quick-action" data-quick-action="library"><AdwIcon name="text-x-generic" /><span data-i18n="allPosts">全部文章</span></button>
              <button type="button" class="quick-action" data-quick-action="desktop"><AdwIcon name="user-desktop" /><span data-i18n="showDesktop">显示桌面</span></button>
              <button type="button" class="quick-action quick-action--wide" data-quick-action="about"><AdwIcon name="help-about" /><span data-i18n="about">关于博客</span><AdwIcon name="go-next" /></button>
              {mobileContacts.length > 0 && (
                <details class="mobile-only quick-contact">
                  <summary class="quick-action"><AdwIcon name="mail-message-new" /><span data-i18n="contact">联系方式</span><AdwIcon name="go-next" class="contact-chevron" /></summary>
                  <div class="quick-contact-links">
                    <ContactActions items={mobileContacts} rowClass="quick-action" />
                  </div>
                </details>
              )}
              <a class="quick-action quick-action--wide" href="/rss.xml"><AdwIcon name="application-rss+xml" /><span data-i18n="rss">RSS 订阅</span><AdwIcon name="go-next" /></a>
            </div>
          </div>
          {endpoint && (
            <article class="mobile-only quick-music" hidden aria-label="Spotify 播放状态" data-i18n-aria="spotifyStatus">
              <SpotifyPlayback compact />
              <a class="quick-music-link" data-spotify-link target="_blank" rel="noopener noreferrer" aria-label="在 Spotify 打开" data-i18n-aria="openSpotify" hidden></a>
            </article>
          )}
        </div>
      </div>
    </div>
  </div>
</header>
