---
import { Icon } from 'astro-icon/components';
import AdwIcon from './AdwIcon.astro';
import MusicWave from './MusicWave.astro';

const endpoint = import.meta.env.PUBLIC_SPOTIFY_ENDPOINT;
const email = 'xiaozhangshiw@163.com';
---
<header class="topbar" data-spotify-endpoint={endpoint}>
  <div class="topbar-start">
    <span class="workspace-indicator" aria-hidden="true"><i class="workspace-current"></i><i></i></span>

    <div class="shell-menu" data-disclosure data-align="start">
      <button type="button" class="shell-trigger shell-contact" data-disclosure-trigger aria-controls="github-menu" aria-expanded="false">GitHub</button>
      <div class="disclosure-panel shell-popover shell-list" id="github-menu" inert>
        <a class="shell-list-row" href="https://github.com/xiaozhangup" target="_blank" rel="noopener noreferrer">
          <Icon name="simple-icons:github" aria-hidden="true" /><span data-i18n="githubProfile">GitHub 主页</span>
        </a>
        <a class="shell-list-row" href="https://github.com/xiaozhangup/xiaozhangup.github.io" target="_blank" rel="noopener noreferrer">
          <AdwIcon name="text-x-generic" /><span data-i18n="blogSource">博客源码</span>
        </a>
      </div>
    </div>

    <div class="shell-menu" data-disclosure data-align="start">
      <button type="button" class="shell-trigger shell-contact" data-i18n="email" data-disclosure-trigger aria-controls="email-menu" aria-expanded="false">邮箱</button>
      <div class="disclosure-panel shell-popover shell-list" id="email-menu" inert>
        <a class="shell-list-row" href={`mailto:${email}`}><AdwIcon name="mail-message-new" /><span>{email}</span></a>
        <button type="button" class="shell-list-row" data-copy-email={email}><AdwIcon name="edit-copy" /><span data-i18n="copyEmail">复制邮箱</span></button>
      </div>
    </div>
    <span class="visually-hidden" data-active-title>文章</span>

    {endpoint && (
      <div class="shell-menu music-menu" data-disclosure data-align="center">
        <button type="button" class="music-pill" data-disclosure-trigger aria-controls="music-menu" aria-expanded="false" aria-label="Spotify 播放状态" data-i18n-aria="spotifyStatus">
          <span class="music-symbol">
            <Icon name="simple-icons:spotify" aria-hidden="true" />
            <img data-spotify-cover alt="" width="18" height="18" />
          </span>
          <span class="music-pill-label" data-spotify-pill>Spotify</span>
          <MusicWave />
        </button>

        <div class="disclosure-panel shell-popover music-popover" id="music-menu" inert>
          <div class="music-idle" data-spotify-idle>
            <Icon name="simple-icons:spotify" aria-hidden="true" />
            <span data-spotify-status>Spotify</span>
          </div>
          <div class="music-playing" data-spotify-playing hidden>
            <div class="music-main">
              <div class="music-cover"><Icon name="simple-icons:spotify" aria-hidden="true" /><img data-spotify-cover alt="" width="84" height="84" /></div>
              <div class="music-track">
                <strong data-spotify-title></strong>
                <span data-spotify-artist></span>
              </div>
              <MusicWave expanded />
            </div>
            <div class="music-footer">
              <div class="music-timeline" data-spotify-timeline hidden>
                <span class="music-time" data-spotify-elapsed>0:00</span>
                <div class="music-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="播放进度" data-i18n-aria="playbackProgress" data-spotify-progress><i></i></div>
                <span class="music-time" data-spotify-duration>0:00</span>
              </div>
              <a class="spotify-open" data-spotify-link target="_blank" rel="noopener noreferrer" title="在 Spotify 打开" aria-label="在 Spotify 打开" data-i18n-aria="openSpotify" hidden><Icon name="simple-icons:spotify" aria-hidden="true" /></a>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>

  <div class="shell-menu clock-menu" data-disclosure data-align="center">
    <button type="button" class="shell-trigger clock-trigger" data-disclosure-trigger aria-controls="clock-menu" aria-expanded="false" aria-label="日期与日历" data-i18n-aria="calendar">
      <time class="topbar-clock" data-clock>博客桌面</time>
    </button>
    <div class:list={['disclosure-panel', 'shell-popover', 'clock-popover', endpoint && 'has-music']} id="clock-menu" inert>
      {endpoint && (
        <div class="clock-media">
          <div class="clock-media-card">
            <div class="clock-media-heading"><Icon name="simple-icons:spotify" aria-hidden="true" /> Spotify <span data-i18n="listeningNow" data-spotify-playing hidden>我正在听</span></div>
            <div class="clock-media-idle" data-spotify-status data-spotify-idle>正在读取播放状态</div>
            <div class="clock-media-track" data-spotify-playing hidden>
              <div class="music-cover"><Icon name="simple-icons:spotify" aria-hidden="true" /><img data-spotify-cover alt="" width="40" height="40" /></div>
              <div class="clock-track-text"><strong data-spotify-title></strong><span data-spotify-artist></span></div>
              <a class="spotify-open" data-spotify-link target="_blank" rel="noopener noreferrer" title="在 Spotify 打开" aria-label="在 Spotify 打开" data-i18n-aria="openSpotify" hidden><Icon name="simple-icons:spotify" aria-hidden="true" /></a>
            </div>
          </div>
        </div>
      )}
      <section class="calendar-pane" data-calendar>
        <div class="calendar-weekday" data-calendar-weekday></div>
        <div class="calendar-today" data-calendar-today></div>
        <div class="calendar-nav">
          <button type="button" data-month-step="-1" data-i18n-aria="previousMonth" aria-label="上个月"><AdwIcon name="go-previous" /></button>
          <strong data-calendar-month aria-live="polite"></strong>
          <button type="button" data-month-step="1" data-i18n-aria="nextMonth" aria-label="下个月"><AdwIcon name="go-next" /></button>
        </div>
        <div class="calendar-grid" data-calendar-grid></div>
      </section>
    </div>
  </div>

  <div class="topbar-end">
    <div class="shell-menu" data-disclosure data-align="center">
      <button type="button" class="shell-trigger language-trigger" data-disclosure-trigger aria-controls="language-menu" aria-expanded="false" data-i18n-aria="changeLanguage" aria-label="切换语言"><span data-language-indicator>拼</span></button>
      <div class="disclosure-panel shell-popover shell-list language-popover" id="language-menu" inert>
        <button type="button" class="shell-list-row" data-set-language="zh" lang="zh-CN" aria-pressed="true">中文</button>
        <button type="button" class="shell-list-row" data-set-language="en" lang="en" aria-pressed="false">English</button>
      </div>
    </div>
    <div class="shell-menu" data-disclosure data-align="end">
      <button type="button" class="shell-trigger quick-trigger" data-disclosure-trigger aria-controls="quick-settings" aria-expanded="false" data-i18n-aria="quickSettings" aria-label="快捷设置">
        {endpoint && <AdwIcon name="audio-x-generic" class="status-playing" />}
        <AdwIcon name="weather-clear-night" class="status-dark" />
        <AdwIcon name="weather-clear" class="status-light" />
        <AdwIcon name="avatar-default" class="status-profile" />
      </button>
      <div class="disclosure-panel shell-popover quick-popover" id="quick-settings" inert>
        <div class="quick-grid">
          <button type="button" class="quick-action" data-theme-toggle aria-pressed="true"><AdwIcon name="weather-clear-night" /><span data-i18n="darkStyle">暗色样式</span></button>
          <button type="button" class="quick-action" data-motion-toggle aria-pressed="true"><AdwIcon name="view-app-grid" /><span data-i18n="animations">界面动画</span></button>
          <button type="button" class="quick-action" data-quick-action="library"><AdwIcon name="text-x-generic" /><span data-i18n="allPosts">全部文章</span></button>
          <button type="button" class="quick-action" data-quick-action="desktop"><AdwIcon name="user-desktop" /><span data-i18n="showDesktop">显示桌面</span></button>
          <button type="button" class="quick-action quick-action--wide" data-quick-action="about"><AdwIcon name="dialog-information" /><span data-i18n="about">关于博客</span><AdwIcon name="go-next" /></button>
          <a class="quick-action quick-action--wide" href="/rss.xml"><AdwIcon name="application-rss+xml" /><span data-i18n="rss">RSS 订阅</span><AdwIcon name="go-next" /></a>
        </div>
      </div>
    </div>
  </div>
</header>
