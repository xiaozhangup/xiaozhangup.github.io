---
interface Props {
  frontmatter: { title: string; description?: string };
}
const { frontmatter } = Astro.props;
const title = `${frontmatter.title} | xiaozhangup 的博客`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={frontmatter.description ?? 'xiaozhangup 的个人博客'} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <header><a href="/">xiaozhangup 的博客</a></header>
    <main><slot /></main>
    <footer><a href="https://github.com/xiaozhangup">GitHub · xiaozhangup</a></footer>
  </body>
</html>
<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; color: #222; background: #fff; font: 16px/1.7 system-ui, sans-serif; }
  header, main, footer { max-width: 800px; margin: auto; padding: 24px; }
  header { border-bottom: 1px solid #e8e8e8; font-size: 22px; }
  main { min-height: 65vh; overflow-wrap: anywhere; }
  footer { border-top: 1px solid #e8e8e8; }
  h1 { line-height: 1.3; font-size: 2rem; }
  a { color: #175fa9; text-underline-offset: 3px; }
  img { max-width: 100%; height: auto; }
  pre { overflow-x: auto; padding: 16px; }
</style>
