---
import DesktopShell from '@layouts/DesktopShell.astro';
import { getTagPaginationPaths } from '@utils/paginationUtils';
export async function getStaticPaths({ paginate }: { paginate: any }) { return getTagPaginationPaths({ paginate }); }
const tag = decodeURIComponent(Astro.params.tag!);
---
<DesktopShell title={tag} initialFilter="tag" filterValue={tag} />
