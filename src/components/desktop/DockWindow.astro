---
interface Props { kind: 'library' | 'reader' | 'about' | 'music'; label: string; href: string; active?: boolean }
const { kind, label, href, active } = Astro.props;
const icon = { library: 'gnome-files', reader: 'text-x-generic', about: 'help-about', music: 'gnome-music' }[kind];
---
<a class:list={['dock-item', active && 'is-active']} href={href} data-dock-window={kind} data-tooltip={label} aria-label={label}>
  <span class="dock-item-visual" aria-hidden="true">
    <img class="dock-app" src={`/adwaita/color/${icon}.svg`} alt="" />
    <span class="dock-dot"></span>
  </span>
</a>
