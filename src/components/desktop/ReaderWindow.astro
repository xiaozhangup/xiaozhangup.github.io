---
import AdwIcon from './AdwIcon.astro';
import WindowControls from './WindowControls.astro';
import WindowResizeAreas from './WindowResizeAreas.astro';

interface Props { title?: string; url?: string; visible?: boolean }
const { title = '文章', url, visible = false } = Astro.props;
---
<section class="window window--reader sidebar-hidden" data-window="reader" data-visible={visible ? '' : undefined} data-active={visible ? '' : undefined} inert={!visible} data-article-url={url} aria-label="文章阅读器">
  <header class="window-header">
    <div class="window-header-leading">
      <button type="button" class="toolbar-icon sidebar-toggle" data-reader-toc-toggle data-i18n-aria="showOutline" aria-controls="reader-toc-initial" aria-expanded="false" aria-label="显示或隐藏目录" title="显示或隐藏目录"><AdwIcon name="sidebar-show" /></button>
      <span class="window-name" data-i18n="outline">目录</span>
    </div>
    <a href="/blog/" data-open-library data-app-back class="toolbar-icon" data-i18n-aria="backToPosts" aria-label="返回文章列表" title="返回文章列表"><AdwIcon name="go-previous" /></a>
    <button type="button" class="window-drag" data-drag-handle data-i18n-aria="moveWindow" aria-label="移动窗口，使用方向键调整位置" title="移动窗口，使用方向键调整位置"><span class="window-title" data-reader-title>{title}</span></button>
    <span class="mobile-reader-title mobile-only" data-reader-title>{title}</span>
    <div class="window-controls">
      <button type="button" class="toolbar-icon" data-copy-link data-i18n-aria="copyLink" aria-label="复制文章链接" title="复制文章链接"><AdwIcon name="external-link" /></button>
      <WindowControls name="reader" />
    </div>
  </header>
  <div class="reader-layout">
    <aside class="library-sidebar reader-sidebar" id="reader-toc-initial" data-reader-sidebar inert>
      <nav data-reader-toc data-i18n-aria="outline" aria-label="目录"><slot name="toc" /></nav>
    </aside>
    <div class="reader-scroll" data-reader-content><slot /></div>
  </div>
  <WindowResizeAreas />
</section>
