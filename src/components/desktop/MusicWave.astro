---
interface Props { expanded?: boolean }
const { expanded = false } = Astro.props;
const bars = expanded ? 10 : 5;
const stroke = expanded ? 3 : 2;
const width = bars * (stroke + 2) - 2;
const height = expanded ? 80 : 16;
---
<canvas class:list={['music-wave', !expanded && 'pill-wave']} data-music-wave={bars} data-wave-stroke={stroke} width={width} height={height} style={`--wave-width:${width}px;--wave-height:${height}px`} aria-hidden="true"></canvas>
