---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { SITE_TITLE } from '@/config';
import { friendLinks, labelPair, shortcuts } from '@/desktopLinks';
import FriendWindow from '@/components/desktop/FriendWindow.astro';
import DesktopBasics from '@/components/desktop/DesktopBasics.astro';
import AdwIcon from '@/components/desktop/AdwIcon.astro';
import ShellBar from '@/components/desktop/ShellBar.astro';
import ReaderWindow from '@/components/desktop/ReaderWindow.astro';
import MusicWindow from '@/components/desktop/MusicWindow.astro';
import DockWindow from '@/components/desktop/DockWindow.astro';
import WindowControls from '@/components/desktop/WindowControls.astro';
import WindowResizeAreas from '@/components/desktop/WindowResizeAreas.astro';
import { getAllPosts, sortPostsByPinAndDate, translationKey } from '@utils/blogUtils';
import '@/styles/desktop.css';
import '@/styles/link-icons.css';
import '@/styles/shell.css';
import '@/styles/motion.css';
import '@/styles/mobile.css';
import '@/styles/listening.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  initialWindow?: 'library' | 'reader' | 'about' | 'music';
  initialFilter?: 'all' | 'categories' | 'tags' | 'archives' | 'search' | 'category' | 'tag';
  filterValue?: string;
  article?: CollectionEntry<'blog'>;
}
const { title = '文章', description = 'xiaozhangup 的个人博客', initialWindow = 'library', initialFilter = 'all', filterValue = '', article } = Astro.props;
const posts = sortPostsByPinAndDate(await getAllPosts());
const translations = new Map((await getCollection('blogTranslations')).filter(post => !import.meta.env.PROD || !post.data.draft).map(post => [translationKey(post), post]));
const categories = [...new Set(posts.flatMap((post) => post.data.categories ?? []))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
const navItems = [
  { label: '全部文章', href: '/blog/', icon: 'user-home', kind: 'all' },
  { label: '分类', href: '/blog/categories/', icon: 'folder', kind: 'categories' },
  { label: '标签', href: '/blog/tags/', icon: 'user-bookmarks', kind: 'tags' },
  { label: '归档', href: '/blog/archives/', icon: 'document-open-recent', kind: 'archives' },
].map((item) => ({
  ...item,
  selected: initialFilter === item.kind || initialFilter === 'category' && item.kind === 'categories' || initialFilter === 'tag' && item.kind === 'tags',
}));
const filterLabels: Record<string, string> = { all: '全部文章', categories: '分类', tags: '标签', archives: '归档', search: '搜索结果', category: filterValue, tag: filterValue };
const desktopMedia = '(width > 760px) and ((height > 480px) or (pointer: fine) or (pointer: none))';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const date = (d: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Shanghai' }).format(d);
---
<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#222226" />
    <meta property="og:title" content={`${title} · xiaozhangup`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/profile.png', Astro.site).href} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/profile.png" />
    <link rel="alternate" type="application/rss+xml" title="xiaozhangup 的博客" href="/rss.xml" />
    <link rel="preload" as="image" href="/wallpapers/desktop-wide.jpg" media={`${desktopMedia} and (aspect-ratio <= 21/10)`} />
    <link rel="preload" as="image" href="/wallpapers/desktop-ultrawide.jpg" media={`${desktopMedia} and (aspect-ratio > 21/10)`} />
    <title>{article ? title : 'xiaozhangup 的博客'}</title>
  </head>
  <body data-initial-window={initialWindow} data-initial-filter={initialFilter} data-filter-value={filterValue}>
    <a class="skip-link" href="#desktop-main" data-i18n="skipToContent">跳到主要内容</a>
    <ShellBar />
    <main id="desktop-main" class="desktop" data-workspace="1" tabindex="-1">
      <button type="button" class="dock-edge" data-dock-edge aria-label="显示桌面应用" data-i18n-aria="showDock" aria-controls="desktop-dock" aria-expanded="false" hidden></button>
      <div class="dock-anchor" data-dock-anchor>
        <nav class="dock" id="desktop-dock" data-i18n-aria="desktopApps" aria-label="桌面应用">
          <DockWindow kind="library" label="文章" href="/blog/" active={initialWindow === 'library'} />
          {initialWindow === 'reader' && <DockWindow kind="reader" label={title} href={Astro.url.pathname} active />}
          {initialWindow === 'music' && <DockWindow kind="music" label="音乐" href="/music/" active />}
          {initialWindow === 'about' && <DockWindow kind="about" label="关于博客" href="/about/" active />}
        </nav>
      </div>
      <template data-dock-template><DockWindow kind="library" label="" href="/blog/" /></template>

      <section class="desktop-workspace" id="workspace-one" aria-label="工作区 1" data-i18n-aria="workspaceOne">
        <p class="visually-hidden" id="desktop-shortcut-help" data-i18n="moveShortcut">可用方向键移动桌面图标，按 Delete 移至回收站。</p>
        <p class="visually-hidden" id="desktop-trash-help" data-i18n="moveTrash">可用方向键移动回收站。</p>
        <div class="desktop-icons" data-i18n-aria="desktopShortcuts" aria-label="桌面快捷方式">
          <DesktopBasics shortcutHelp="desktop-shortcut-help" trashHelp="desktop-trash-help" />
          <a href="/music/" data-open-music class="desktop-shortcut" data-shortcut-home="top-right" aria-describedby="desktop-shortcut-help"><img src="/adwaita/color/gnome-music.svg" alt="" /><span data-i18n="music">音乐</span></a>
          <a href="/about/" data-open-about class="desktop-shortcut" data-shortcut-home="top-right" aria-describedby="desktop-shortcut-help"><img src="/adwaita/color/help-about.svg" alt="" /><span data-i18n="aboutShort">关于</span></a>
          {shortcuts.map((item) => {
            const label = labelPair(item.label);
            return (
              <a href={item.href} target={item.newTab === false ? undefined : "_blank"} rel={item.newTab === false ? undefined : "noopener noreferrer"} class="desktop-shortcut" data-shortcut-home="bottom-left" aria-describedby="desktop-shortcut-help">
                <img src={item.icon} alt="" /><span data-label-zh={label.zh} data-label-en={label.en}>{label.zh}</span>
              </a>
            );
          })}
        </div>

        <section class="window window--library" data-window="library" data-visible data-active={initialWindow === 'library' ? '' : undefined} aria-label="文章">
          <header class="window-header">
            <div class="window-header-leading">
              <button type="button" class="toolbar-icon sidebar-toggle" data-toggle-sidebar data-i18n-aria="showSidebar" aria-controls="library-sidebar" aria-expanded="true" aria-label="显示或隐藏侧栏" title="显示或隐藏侧栏"><AdwIcon name="sidebar-show" /></button>
              <button type="button" class="toolbar-icon mobile-only app-search-toggle" data-mobile-search data-focus-search data-i18n-aria="searchAction" aria-controls="library-search" aria-expanded={initialFilter === 'search' ? 'true' : 'false'} aria-label="搜索文章" title="搜索文章"><AdwIcon name="system-search" /></button>
              <span class="window-name" data-i18n="posts">文章</span>
              <span class="mobile-only app-site-title">{SITE_TITLE}</span>
            </div>
            <button type="button" class="window-drag" data-drag-handle data-i18n-aria="moveWindow" aria-label="移动窗口，使用方向键调整位置" title="移动窗口，使用方向键调整位置"></button>
            <div class="window-location">
              <div class="window-path" data-library-path hidden={initialFilter === 'search'}>
                <AdwIcon name="user-home" /><span data-breadcrumb>{filterLabels[initialFilter]}</span>
              </div>
              <form class="library-search" id="library-search" action="/blog/search/" role="search" data-search-form hidden={initialFilter !== 'search'}>
                <AdwIcon name="folder-saved-search" />
                <input type="search" name="q" placeholder="搜索文章、分类或标签" aria-label="搜索文章、分类或标签" data-i18n-placeholder="searchPlaceholder" data-i18n-aria="searchPlaceholder" data-search />
              </form>
            </div>
            <div class="window-controls">
              <button type="button" class="toolbar-icon" data-focus-search data-i18n-aria="searchAction" aria-controls="library-search" aria-expanded={initialFilter === 'search' ? 'true' : 'false'} aria-label="搜索文章" title="搜索文章"><AdwIcon name="folder-saved-search" /></button>
              <WindowControls name="library" />
            </div>
          </header>

          <div class="library-layout">
            <aside class="library-sidebar" id="library-sidebar">
              <nav class="library-nav" data-i18n-aria="postNavigation" aria-label="文章导航">
                {navItems.map((item) => (
                  <a href={item.href} data-desktop-filter={item.kind} class:list={['side-link', item.selected && 'is-selected']}>
                    <AdwIcon name={item.icon} /><span data-i18n={item.kind === 'all' ? 'allPosts' : item.kind}>{item.label}</span>
                  </a>
                ))}
              </nav>
              {categories.length > 0 && (
                <nav class="library-nav library-nav--sub" data-i18n-aria="postCategories" aria-label="文章分类">
                  {categories.map((category) => (
                    <a href={`/blog/category/${encodeURIComponent(category)}/`} data-desktop-filter="category" data-value={category} class:list={['side-link', initialFilter === 'category' && filterValue === category && 'is-selected']}>
                      <AdwIcon name="folder" /><span>{category}</span>
                    </a>
                  ))}
                </nav>
              )}
            </aside>
            <div class="library-main">
              <div class="library-scroll">
                <div class="library-summary">
                  <h1 class="library-heading" data-library-heading tabindex="-1">{filterLabels[initialFilter]}</h1>
                  <span class="window-status" data-status-count>{posts.length} 篇文章</span>
                </div>
                <div class="folder-grid" data-category-chips hidden={initialFilter !== 'categories'}>
                  {categories.map((category) => (
                    <a class="folder-item" href={`/blog/category/${encodeURIComponent(category)}/`} data-desktop-filter="category" data-value={category}>
                      <img src="/adwaita/color/folder-documents.svg" width="48" height="48" alt="" /><span>{category}</span>
                    </a>
                  ))}
                  {categories.length === 0 && <p class="empty-list" data-i18n="noCategories">暂无分类</p>}
                </div>
                <div class="folder-grid" data-tag-chips hidden={initialFilter !== 'tags'}>
                  {tags.map((tag) => (
                    <a class="folder-item" href={`/blog/tag/${encodeURIComponent(tag)}/`} data-desktop-filter="tag" data-value={tag}>
                      <img src="/adwaita/color/user-bookmarks.svg" width="48" height="48" alt="" /><span>{tag}</span>
                    </a>
                  ))}
                  {tags.length === 0 && <p class="empty-list" data-i18n="noTags">暂无标签</p>}
                </div>

                <div class="files-view" data-files-view hidden={initialFilter === 'categories' || initialFilter === 'tags'}>
                  <div class="file-columns" aria-hidden="true">
                    <span data-i18n="name">名称</span><span class="file-date" data-i18n="published">发布日期</span>
                  </div>
                  <div class="post-list" data-post-list>
                    {posts.map((post) => {
                      const translated = translations.get(translationKey(post));
                      const matches = initialFilter === 'category' ? (post.data.categories ?? []).includes(filterValue) : initialFilter === 'tag' ? (post.data.tags ?? []).includes(filterValue) : true;
                      return (
                        <article class="post-row" data-post-row data-title={post.data.title.toLocaleLowerCase()} data-description={post.data.description.toLocaleLowerCase()} data-title-en={translated?.data.title.toLocaleLowerCase()} data-description-en={translated?.data.description.toLocaleLowerCase()} data-categories={JSON.stringify(post.data.categories ?? [])} data-tags={JSON.stringify(post.data.tags ?? [])} hidden={!matches}>
                          <a class="post-main" href={`/blog/${post.id}/`} data-open-article>
                            <span class="post-name">
                              <img src="/adwaita/color/text-x-generic.svg" width="32" height="32" alt="" />
                              <span class="post-copy">
                                <strong data-post-title data-zh={post.data.title} data-en={translated?.data.title ?? post.data.title}>{post.data.title}</strong>
                                <small data-post-description data-zh={post.data.description} data-en={translated?.data.description ?? post.data.description}>{post.data.description}</small>
                              </span>
                            </span>
                            <time class="file-date post-date" datetime={post.data.pubDate.toISOString()}>{date(post.data.pubDate)}</time>
                            <AdwIcon class="app-post-chevron mobile-only" name="go-next" />
                          </a>
                        </article>
                      );
                    })}
                    <div class="empty-list" data-empty-list hidden>
                      <AdwIcon name="system-search" /><strong data-i18n="noResults">没有找到文章</strong><span data-i18n="tryAnotherSearch">换个关键词或查看全部文章。</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <nav class="mobile-only app-view-switcher" data-i18n-aria="postNavigation" aria-label="文章导航">
            {navItems.map((item) => (
              <a href={item.href} data-desktop-filter={item.kind} aria-current={item.selected ? 'page' : undefined}>
                <AdwIcon name={item.kind === 'all' ? 'text-x-generic' : item.icon} />
                <span data-i18n={item.kind === 'all' ? 'allPosts' : item.kind}>{item.label}</span>
              </a>
            ))}
          </nav>
          <WindowResizeAreas />
        </section>

        {initialWindow === 'reader' && <ReaderWindow title={title} url={Astro.url.pathname} visible>
          <slot name="article" />
          <Fragment slot="toc"><slot name="toc" /></Fragment>
        </ReaderWindow>}
        <template data-reader-template><ReaderWindow /></template>

        <section class="window window--about" data-window="about" data-visible={initialWindow === 'about' ? '' : undefined} data-active={initialWindow === 'about' ? '' : undefined} inert={initialWindow !== 'about'} aria-label="关于博客">
          <header class="window-header">
            <div class="mobile-about-back mobile-only">
              <a href="/blog/" data-open-library data-app-back class="toolbar-icon" data-i18n-aria="backToPosts" aria-label="返回文章列表"><AdwIcon name="go-previous" /></a>
            </div>
            <span class="mobile-about-title mobile-only" data-i18n="aboutShort">关于</span>
            <button type="button" class="window-drag" data-drag-handle data-i18n-aria="moveWindow" aria-label="移动窗口，使用方向键调整位置" title="移动窗口，使用方向键调整位置"><span class="window-title" data-i18n="aboutShort">关于</span></button>
            <div class="window-controls"><WindowControls name="about" /></div>
          </header>
          <div class="about-content">
            <img class="about-avatar" src="/profile.png" width="96" height="96" alt="" />
            <h2>xiaozhangup</h2>
            <p data-i18n="welcome">欢迎来到我的个人博客。</p>
            <div class="about-links">
              <a href="https://github.com/xiaozhangup" target="_blank" rel="noopener noreferrer"><Icon name="simple-icons:github" aria-hidden="true" /><span>GitHub</span><AdwIcon name="external-link" /></a>
              <a href="/rss.xml"><AdwIcon name="application-rss+xml" /><span data-i18n="rss">RSS 订阅</span><AdwIcon name="go-next" /></a>
            </div>
          </div>
          <WindowResizeAreas />
        </section>
        <MusicWindow active={initialWindow === 'music'} />
      </section>
      <section class="desktop-workspace desktop-workspace--friends" id="workspace-two" aria-label="工作区 2" data-i18n-aria="workspaceTwo" inert>
        <p class="visually-hidden" id="desktop-shortcut-help-two" data-i18n="moveShortcut">可用方向键移动桌面图标，按 Delete 移至回收站。</p>
        <p class="visually-hidden" id="desktop-trash-help-two" data-i18n="moveTrash">可用方向键移动回收站。</p>
        <div class="desktop-icons" data-i18n-aria="desktopShortcuts" aria-label="桌面快捷方式">
          <DesktopBasics shortcutHelp="desktop-shortcut-help-two" trashHelp="desktop-trash-help-two" />
          {friendLinks.map((item, index) => {
            const label = labelPair(item.label);
            return (
              <a href={item.href} class="desktop-shortcut" data-shortcut-home="top-right" data-open-friend aria-controls={`friend-window-${index}`} aria-describedby="desktop-shortcut-help-two">
                <img src={item.icon} alt="" /><span data-label-zh={label.zh} data-label-en={label.en}>{label.zh}</span>
              </a>
            );
          })}
        </div>
        {friendLinks.map((item, index) => <FriendWindow id={`friend-window-${index}`} item={item} />)}
      </section>
      <div class="visually-hidden" aria-live="polite" data-announcer></div>
    </main>
    <script src="../desktop/desktop.ts"></script>
  </body>
</html>
